/* ==========================================================================
   MEOW ADMINISTRADOR PRO // PALETAS & ESTILOS TUI
   ========================================================================== */

/* 1. 🟢 Phosphor Green (Predeterminado) */
:root {
  --bg-color: #050b08;
  --panel-bg: #0d1a12;
  --border-color: #00ff66;
  --text-primary: #00ff66;
  --text-muted: #00993d;
  --accent-alert: #ff3366;
  --accent-warn: #ffb000;
  --accent-info: #00e5ff;
  --font-mono: 'Fira Code', 'Courier New', monospace;
}

/* 2. 🟠 Amber CRT */
body.theme-amber {
  --bg-color: #0f0900; --panel-bg: #1c1202; --border-color: #ffb000;
  --text-primary: #ffb000; --text-muted: #996a00; --accent-alert: #ff4444;
}

/* 3. 🔵 Cyber Cyan */
body.theme-cyan {
  --bg-color: #020d14; --panel-bg: #051a26; --border-color: #00e5ff;
  --text-primary: #00e5ff; --text-muted: #008ba3; --accent-alert: #ff2a6d;
}

/* 4. 🟣 Dracula Synth */
body.theme-dracula {
  --bg-color: #120e17; --panel-bg: #1f1829; --border-color: #bd93f9;
  --text-primary: #ff79c6; --text-muted: #8be9fd; --accent-alert: #ff5555;
}

/* 5. ⚪ Monochrome */
body.theme-mono {
  --bg-color: #0a0a0a; --panel-bg: #171717; --border-color: #e5e5e5;
  --text-primary: #f5f5f5; --text-muted: #a3a3a3; --accent-alert: #ffffff;
}

/* 6. ☕ Cappuccino */
body.theme-cappuccino {
  --bg-color: #120d0a; --panel-bg: #211813; --border-color: #d7ba9d;
  --text-primary: #e8d3c0; --text-muted: #a38a75; --accent-alert: #d97706;
}

/* CONFIGURACIÓN ANTI-REBOTE E INTERFAZ ESTÁTICA */
html, body {
  width: 100%; height: 100%; max-height: 100vh;
  overflow: hidden; overscroll-behavior: none; touch-action: manipulation;
}

* { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }

body {
  background-color: var(--bg-color); color: var(--text-primary);
  font-family: var(--font-mono); padding: 10px; max-width: 650px;
  margin: 0 auto; display: flex; flex-direction: column;
}

/* CONTENEDOR Y ENCABEZADOS */
.terminal-header {
  background: var(--panel-bg); border: 1px solid var(--border-color);
  border-radius: 8px 8px 0 0; padding: 10px 14px; display: flex;
  justify-content: space-between; align-items: center; border-bottom: none;
}
.window-dots { display: flex; gap: 6px; }
.dot { width: 10px; height: 10px; border-radius: 50%; }
.dot.red { background: #ff5f56; } .dot.yellow { background: #ffbd2e; } .dot.green { background: #27c93f; }
.terminal-title { font-size: 0.75rem; color: var(--text-muted); font-weight: bold; }

.status-bar {
  background: rgba(0, 0, 0, 0.4); border: 1px solid var(--border-color);
  padding: 8px 12px; font-size: 0.7rem; display: flex; justify-content: space-between;
}

.terminal-container {
  background: var(--panel-bg); border: 1px solid var(--border-color);
  border-radius: 0 0 8px 8px; padding: 14px; flex: 1; display: flex;
  flex-direction: column; overflow: hidden;
}

.nav-tabs {
  display: flex; gap: 6px; margin-bottom: 12px;
  border-bottom: 1px solid var(--border-color); padding-bottom: 8px; overflow-x: auto;
}
.tab-btn {
  background: transparent; border: 1px solid var(--border-color);
  color: var(--text-primary); padding: 6px 10px; font-family: var(--font-mono);
  font-size: 0.7rem; cursor: pointer; border-radius: 4px; white-space: nowrap;
}
.tab-btn.active { background: var(--border-color); color: #000; font-weight: bold; }

.filter-bar { display: flex; gap: 6px; margin-bottom: 10px; }
.input-tui {
  background: rgba(0,0,0,0.5); border: 1px solid var(--border-color);
  color: var(--text-primary); font-family: var(--font-mono); font-size: 0.75rem;
  padding: 6px 8px; border-radius: 3px; outline: none; width: 100%;
}

.tab-content { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
.scrollable-area { flex: 1; overflow-y: auto; overscroll-behavior-y: contain; padding-right: 4px; }
.scrollable-area::-webkit-scrollbar { width: 4px; }
.scrollable-area::-webkit-scrollbar-thumb { background: var(--border-color); }

/* TARJETAS Y COMPONENTES */
.log-card {
  background: rgba(0, 0, 0, 0.2); border: 1px solid var(--border-color);
  border-left: 4px solid var(--text-primary); border-radius: 4px;
  padding: 10px; margin-bottom: 10px;
}
.log-card.read { border-left-color: var(--text-muted); opacity: 0.8; }
.log-header { display: flex; justify-content: space-between; font-size: 0.7rem; color: var(--text-muted); margin-bottom: 6px; }
.log-body { font-size: 0.75rem; line-height: 1.4; margin-bottom: 8px; user-select: text; }
.log-actions { display: flex; gap: 6px; flex-wrap: wrap; }

.tag-badge {
  font-size: 0.65rem; padding: 2px 4px; border-radius: 2px;
  border: 1px solid currentColor; display: inline-block; margin-left: 4px;
}
.tag-PENDING { color: var(--accent-warn); }
.tag-RESOLVED { color: var(--text-primary); }
.tag-ARCHIVED { color: var(--text-muted); }

.btn-tui {
  background: transparent; color: var(--text-primary); border: 1px solid var(--border-color);
  font-family: var(--font-mono); padding: 5px 8px; font-size: 0.7rem;
  cursor: pointer; border-radius: 3px; font-weight: bold;
}
.btn-tui:active { background: var(--border-color); color: #000; }
.btn-tui.alert { color: var(--accent-alert); border-color: var(--accent-alert); }

.stats-box {
  background: rgba(0, 0, 0, 0.4); border: 1px solid var(--border-color);
  padding: 10px; font-size: 0.75rem; line-height: 1.6; border-radius: 4px; margin-bottom: 10px;
}

/* CASSETTE DECK STYLES */
.cassette-deck {
  background: rgba(0, 0, 0, 0.4); border: 1px solid var(--border-color);
  border-radius: 6px; padding: 12px; margin-top: 6px; display: flex;
  flex-direction: column; align-items: center;
}
.cassette-body {
  width: 100%; max-width: 280px; height: 110px; background: var(--panel-bg);
  border: 2px solid var(--border-color); border-radius: 8px; padding: 10px;
  display: flex; flex-direction: column; justify-content: space-between;
  box-shadow: inset 0 0 10px rgba(0,0,0,0.8);
}
.cassette-label {
  background: var(--border-color); color: #000; font-size: 0.65rem; font-weight: bold;
  padding: 3px 6px; text-align: center; border-radius: 2px; white-space: nowrap;
  overflow: hidden; text-overflow: ellipsis;
}
.cassette-window {
  background: #000; border: 1px solid var(--border-color); height: 48px;
  border-radius: 4px; display: flex; justify-content: space-around; align-items: center; padding: 0 16px;
}
.tape-reel {
  width: 32px; height: 32px; border: 2px dashed var(--border-color); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.tape-reel::after { content: ''; width: 8px; height: 8px; background: var(--border-color); border-radius: 50%; }
.cassette-body.playing .tape-reel { animation: spinReel 2s linear infinite; }
@keyframes spinReel { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
.player-controls { display: flex; gap: 6px; width: 100%; justify-content: center; margin-top: 10px; }

/* ARCADE STYLES */
.arcade-container { display: flex; flex-direction: column; align-items: center; gap: 10px; }
.arcade-screen {
  background: #000; border: 2px solid var(--border-color); border-radius: 4px;
  box-shadow: inset 0 0 10px rgba(0,255,102,0.2); width: 100%; max-width: 320px; height: 200px;
}
.arcade-controls { display: flex; gap: 8px; justify-content: center; width: 100%; max-width: 320px; }
.arcade-btn {
  flex: 1; padding: 10px; background: rgba(0,0,0,0.4); border: 1px solid var(--border-color);
  color: var(--text-primary); font-family: var(--font-mono); font-weight: bold; font-size: 0.8rem;
  border-radius: 4px; cursor: pointer;
}
.arcade-btn:active { background: var(--border-color); color: #000; }

/* MODAL Y SELECT */
.modal-overlay {
  display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.85); z-index: 100; padding: 16px; align-items: center; justify-content: center;
}
.modal-overlay.active { display: flex; }
.modal-content {
  background: var(--panel-bg); border: 1px solid var(--border-color);
  border-radius: 6px; padding: 14px; width: 100%; max-width: 500px;
}
.theme-select {
  background: transparent; color: var(--text-primary); border: 1px solid var(--border-color);
  font-family: var(--font-mono); font-size: 0.7rem; padding: 2px 4px; border-radius: 3px;
}
.footer { text-align: center; font-size: 0.65rem; color: var(--text-muted); margin-top: 8px; }
